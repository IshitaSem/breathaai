# BreatheWise AI Backend Environment Configuration
# Hack2Skill PromptWars Challenge 6

# Gemini API Key (Optional: system safely falls back to local contextual engine when unset)
GEMINI_API_KEY=

# Gemini Model Selection (Configurable: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Server Network Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# SQLite Database Persistence
DATABASE_URL=sqlite:///./breathewise.db

# Allowed CORS Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
